# ============================================================
# SkillLogger 環境変数テンプレート
# 実際の値は .env にコピーして設定する（.env は git 管理外）。
# 秘匿情報（実データ・APIキー・AWS情報）は絶対にコミットしないこと。
# ============================================================

# --- Django ---
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=skill_logger
MYSQL_USER=skill_user
MYSQL_PASSWORD=skill_password
MYSQL_HOST=db
MYSQL_PORT=3306

# --- ローカル公開ポート（複数プロジェクト同時起動時の競合回避用）---
# このマシンで他アプリと同時に動かすため、被らない値に変更してよい。
BACKEND_PORT=19000
FRONTEND_PORT=9999
DB_PORT=13307
PMA_PORT=19080
# フロント → バックエンド API URL（BACKEND_PORT に合わせる）
VITE_API_BASE_URL=http://localhost:19000

# --- MVP 仮認証 ---
# この ID の Django ユーザーを全リクエストに固定する（seed で admin=id:1 が作られる）。
# Phase B の共通 Cognito 化で撤去する。
DEV_FIXED_USER_ID=1

# --- LLM (AI 申請文生成) ---
# API キーは DB(AiConfig) にユーザー単位で保存する。ここには置かない。
# プロバイダ既定以外のエンドポイント（eval-proxy 等）を使う場合のみ設定。
# LLM_API_BASE_URL=

# --- 横断アプリリンク（将来のマルチアプリ横断操作用）---
# 別アプリの URL を "ラベル|URL" のカンマ区切りで指定すると、フロントの
# ヘッダーにそのアプリへのリンクが表示される。
# 例: VITE_APP_LINKS=money-pilot|http://localhost:8888,fair-value|http://localhost:8888
# VITE_APP_LINKS=

# --- AWS / Cognito（本番・Phase B 以降。ローカルでは基本不要）---
# 本番では Terraform / SSM / GitHub Secrets 経由で注入する。ここには実値を書かない。
# COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# COGNITO_REGION=ap-northeast-1
# COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# VITE_COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
