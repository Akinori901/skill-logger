# ============================================================
# SkillLogger 環境変数テンプレート
# 実際の値は .env にコピーして設定する（.env は git 管理外）。
# 秘匿情報（実データ・APIキー・AWS情報）は絶対にコミットしないこと。
# ============================================================

# --- Django ---
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SQLite) ---
# 本番(EFS)・開発・テストすべて SQLite に統一。ローカルは未設定で backend/db.sqlite3 を使う。
# 保存先を変えたい場合のみパスを指定する（本番 Lambda は /mnt/efs/db.sqlite3）。
# SQLITE_PATH=/app/db.sqlite3

# --- ローカル公開ポート（複数プロジェクト同時起動時の競合回避用）---
# このマシンで他アプリと同時に動かすため、被らない値に変更してよい。
BACKEND_PORT=19000
FRONTEND_PORT=9999
# フロント → バックエンド API URL（BACKEND_PORT に合わせる）
VITE_API_BASE_URL=http://localhost:19000

# --- MVP 仮認証 ---
# この ID の Django ユーザーを全リクエストに固定する（seed で admin=id:1 が作られる）。
# Phase B の共通 Cognito 化で撤去する。
DEV_FIXED_USER_ID=1

# --- LLM (AI 申請文生成) ---
# API キーは DB(AiConfig) にユーザー単位で保存する。ここには置かない。
# プロバイダ既定以外のエンドポイント（eval-proxy 等）を使う場合のみ設定。
# LLM_API_BASE_URL=

# --- 横断アプリリンク（将来のマルチアプリ横断操作用）---
# 別アプリの URL を "ラベル|URL" のカンマ区切りで指定すると、フロントの
# ヘッダーにそのアプリへのリンクが表示される。
# 例: VITE_APP_LINKS=app-one|http://localhost:8888,app-two|http://localhost:8888
# VITE_APP_LINKS=

# --- Cognito 認証（共通基盤 qol-user-pool）---
# 値は qol-user-pool の `terraform output` から取得する。
# 本番では Terraform / Lambda env / GitHub Secrets 経由で注入する。
# バックエンド（JWT 検証）:
# COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# COGNITO_REGION=ap-northeast-1
# COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_DOMAIN_PREFIX=qol-auth
# 同じ qol-user-pool を使う他サービスの client_id を追加許可（カンマ区切り）。
# 案件レジストリ連携で Publicity/dev-branding(publicity-web-client)から Engagement API を叩くため。
# COGNITO_EXTRA_CLIENT_IDS=3i40b30o7jd3io6dvvfarm67e5
# 初期管理者メール（seed が許可emailに登録。締め出し防止。qol-user-pool と一致させる）:
# INITIAL_ADMIN_EMAIL=you@example.com
# 共通認証基盤（qol-auth-console）。空なら中央を使わず m_user_allowed_emails だけで判定する。
# 設定すると「中央 OR m_user_allowed_emails」のどちらかで許可されれば通る。
# CENTRAL_AUTHZ_URL=https://xxxxxxxxxx.cloudfront.net
# CENTRAL_AUTHZ_CACHE_TTL=60
# CENTRAL_AUTHZ_TIMEOUT=3.0
# フロントエンド（Amplify。PR4 で使用）:
# VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# VITE_COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_DOMAIN_PREFIX=qol-auth
# VITE_COGNITO_REGION=ap-northeast-1
