# =============================================================================
# 本番用 Dockerfile — AWS Lambda コンテナイメージ
# =============================================================================

FROM public.ecr.aws/lambda/python:3.13

# mysqlclient ビルドに必要なシステム依存
RUN dnf install -y gcc mariadb105-devel pkgconfig && dnf clean all

# uv インストール
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 依存インストール（キャッシュ活用のため先にコピー）
# dev 依存 (ruff/mypy/pytest 等) は本番イメージに含めない。
COPY backend/pyproject.toml ${LAMBDA_TASK_ROOT}/
WORKDIR ${LAMBDA_TASK_ROOT}
RUN uv pip install --system --no-cache -r pyproject.toml

# アプリケーションコードをコピー
COPY backend/ ${LAMBDA_TASK_ROOT}/

# Lambda ハンドラ（Mangum 経由で Django ASGI を実行）
CMD ["config.asgi.handler"]
